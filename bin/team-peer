#!/usr/bin/env python3
"""team-peer: other buildings (offices on other computers reached through Herdr's ssh machines).

  team-peer ls                                   the buildings you can see, their floors and leads, and whether you are connected
  team-peer send <building> <floor> "text" --from <you>
                                                 leave a request for the LEAD of that floor (the only person you can write to there).
                                                 Their answer comes back to your terminal. Needs the buildings connected and both floors switched on.
  team-peer request|accept|decline|disconnect <building>     ask to connect agents / answer a request / end the connection
  team-peer pause|resume <building>              stop talking for a while without disconnecting
  team-peer floor <building> <your floor port> [on|off] [share|noshare]
                                                 per floor of yours: may its agents talk with that building; are its requests shared with it
  team-peer ask <building> [on|off]              may that building's agents open requests straight to YOUR owner (off unless switched on)
  team-peer chats <building> [on|off]            may that building's OWNER read your people's chats when visiting (read only; off unless switched on)
  team-peer me [--name "Building name"] [--owner Name]       this building's name card
  team-peer home [<building>|none]               the building where your owner reads requests. With it set, every request or
                                                 note to the owner (team-ask ... --to __OWNER_ID__) also lands in their box there,
                                                 and their answer comes back and closes it here. Only the owner sets this.
  team-peer flush                                send again the answers that could not reach another building (link down);
                                                 the watchdog does this on its own
  team-peer forget <building>                    remove a building that is not connected (its key, name and switches), so it
                                                 can introduce itself again with a new key. Only the owner does this.

Ending a connection (decline or disconnect, from either side) also switches off what was granted to that building:
shared requests, chats, and requests to the owner. Connecting again starts with them off.

<building> is its id or the start of its name. Store: ~/.omniloy-team/peers.json (connections), peers-seen.json (what was found)."""
import sys, os, json, time, secrets, subprocess, urllib.request, urllib.error, fcntl, re, socket
sys.dont_write_bytecode = True; sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import teamlib as L
H = os.path.expanduser; D = H("~/.omniloy-team"); F = D + "/peers.json"; SEEN = D + "/peers-seen.json"; VISITS = D + "/visits.json"
os.makedirs(D, exist_ok=True)
def load(f, dflt):
    try: return json.load(open(f))
    except Exception: return dflt
def save(f, d):
    tmp = f + ".tmp"; json.dump(d, open(tmp, "w"), indent=1, ensure_ascii=False); os.replace(tmp, f)
class Box:   # one writer at a time
    def __enter__(self):
        self.l = open(F + ".lock", "w"); fcntl.flock(self.l, fcntl.LOCK_EX)
        self.d = L.load(F, {}) or {}; self.d.setdefault("peers", {})   # unreadable: stop, never mint a new identity over it
        if not self.d.get("me"): self.d["me"] = {"id": secrets.token_hex(4), "name": socket.gethostname().split(".")[0] + " office", "owner": ""}
        return self.d
    def __exit__(self, *a):
        if a[0] is None or a[0] is SystemExit: save(F, self.d)
        fcntl.flock(self.l, fcntl.LOCK_UN)
def seen(): return load(SEEN, {})
def find(d, q):
    q = q.lower(); c = [p for p in d["peers"].values() if p["id"] == q or p.get("name", "").lower().startswith(q) or (p.get("machine") or "").lower() == q]
    if len(c) != 1: sys.exit(f'{"no" if not c else "more than one"} building matches "{q}". See: team-peer ls')
    return c[0]
def floors_of(pid): return (seen().get(pid) or {}).get("floors") or []
def call(pid, path, body=None, floor=None, timeout=8):
    """Talk to that building through the tunnel: any of its floors answers for the building, `floor` picks one."""
    fl = floors_of(pid); d = load(F, {}); p = d.get("peers", {}).get(pid) or {}
    fl = [x for x in fl if not floor or str(x["port"]) == str(floor)] or fl
    err = "no way to reach that building right now"
    for x in fl:
        try:
            req = urllib.request.Request(f'http://127.0.0.1:{x["local"]}{path}', data=None if body is None else json.dumps(body).encode(),
                                         headers={"content-type": "application/json", "x-peer-id": d["me"]["id"], "x-peer-key": p.get("key", "")})
            return json.load(urllib.request.urlopen(req, timeout=timeout))
        except urllib.error.HTTPError as e:
            try: r = json.load(e)
            except Exception: r = None
            if e.code in (408, 429) or e.code >= 500:   # the building is there but could not take it now: try again later
                return {**(r if isinstance(r, dict) else {}), "error": (r or {}).get("error") if isinstance(r, dict) and r.get("error") else f"HTTP {e.code}", "unreached": True}
            if isinstance(r, dict): return r
            err = f"HTTP {e.code}"
        except Exception as e: err = str(e)[:120]
    return {"error": err, "unreached": True}   # no answer from the building at all (link down), or it failed: try again later
# Answers to another building's requests that could not travel yet (link down): kept here until that building takes
# them, tried again by `team-peer flush` (the watchdog runs it with its outbox). Never dropped silently.
POUT = D + "/peer-outbox.json"
class Pout:
    def __enter__(self):
        self.l = open(POUT + ".lock", "w"); fcntl.flock(self.l, fcntl.LOCK_EX)
        self.q = L.load(POUT, []) if os.path.exists(POUT) else []
        if not isinstance(self.q, list): sys.exit(f"{POUT} cannot be read: left as it is")
        return self.q
    def __exit__(self, *a):
        if a[0] is None or a[0] is SystemExit:
            tmp = POUT + f".{os.getpid()}.tmp"; json.dump(self.q, open(tmp, "w"), indent=1, ensure_ascii=False); os.chmod(tmp, 0o600); os.replace(tmp, POUT)
        fcntl.flock(self.l, fcntl.LOCK_UN)
def visit(v):   # shown in the rooms: someone teleports out, or a visitor arrives (see travel.js); only a picture, never fatal
    try:
        l = open(VISITS + ".lock", "w"); fcntl.flock(l, fcntl.LOCK_EX)
        now = int(time.time() * 1000); items = [x for x in load(VISITS, []) if x.get("until", 0) > now - 60000]
        items.append({"id": secrets.token_hex(5), "ts": now, **v}); save(VISITS, items); fcntl.flock(l, fcntl.LOCK_UN)
    except Exception: pass
def teams():
    out = {}
    for b in load(D + "/building.json", {}).get("floors") or []:
        t = load(H("~/" + b["dir"] + "/team.json"), None)
        if t: out[str(b["port"])] = {**b, "team": t}
    return out
def person(name):
    for port, f in teams().items():
        tm = load(H("~/" + f["dir"] + "/temps.json"), [])
        for p in f["team"]["personas"] + (tm if isinstance(tm, list) else []):
            if p["herdrName"] == name: return port, f, p
    return None, None, None
def hc(*a): return subprocess.run([H("~/.local/bin/hc"), *a], capture_output=True, text=True)
def ask(*a, stdin=None): return subprocess.run([H("~/.local/bin/team-ask"), *a], capture_output=True, text=True, input=stdin)
def opts(a):
    o, pos = {}, []; i = 0
    while i < len(a):
        if a[i].startswith("--"): o[a[i][2:]] = a[i + 1] if i + 1 < len(a) and not a[i + 1].startswith("--") else True; i += 2 if o[a[i][2:]] is not True else 1
        else: pos.append(a[i]); i += 1
    return o, pos
def ungrant(p):   # a connection that ends takes its grants with it: a new one starts with nothing shared
    p["chats"] = False; p["ask"] = False
    for m in (p.get("my") or {}).values(): m["share"] = False
# What left from here and is waiting for an answer from that building: (building, agent; "" for the owner, who
# writes from the visitor page). An answer from a building is taken only against one of these, and uses it up.
ASKED_DAYS = 30
def asked_add(d, pid, agent):
    cut = time.time() - ASKED_DAYS * 86400
    d["asked"] = [x for x in d.get("asked") or [] if x.get("ts", 0) > cut] + [{"peer": pid, "agent": agent or "", "ts": time.time()}]
def asked_take(d, pid, agent):
    cut = time.time() - ASKED_DAYS * 86400; lst = [x for x in d.get("asked") or [] if x.get("ts", 0) > cut]
    i = next((i for i, x in enumerate(lst) if x.get("peer") == pid and x.get("agent", "") == (agent or "")), None)
    if i is not None: lst.pop(i)
    d["asked"] = lst
    return i is not None
def status_line(p): return {"none": "not connected", "out": "request sent", "in": "wants to connect", "on": "connected", "paused": "paused"}.get(p.get("status", "none"), p.get("status"))

a = sys.argv[1:]; c = a[0] if a else ""; o, pos = opts(a[1:])
if c == "me":
    with Box() as d:
        if o.get("name"): d["me"]["name"] = o["name"]
        if o.get("owner"): d["me"]["owner"] = o["owner"]
        me = dict(d["me"])
    # the name card other computers read over ssh (peer-link.mjs), written only here and always from the floors list,
    # so a test floor run from a checkout cannot replace it with its own floors (every floor runs `team-peer me` at start)
    card = {"id": me.get("id"), "name": me.get("name"), "owner": me.get("owner"), "floors": [{"port": f["port"], "name": f["name"], "dir": f["dir"]} for f in L.floors()]}
    if L.read_quiet(D + "/building.json", None) != card: L.save(D + "/building.json", card)
    print(json.dumps(me, ensure_ascii=False))
elif c == "ls":
    with Box() as d: pass
    s = seen()
    if o.get("json"): print(json.dumps({"me": d["me"], "peers": d["peers"], "seen": s}, ensure_ascii=False)); sys.exit()
    if not d["peers"]: print("No other buildings found.")
    for p in d["peers"].values():
        print(f'{p["name"]}  ({p["id"]}, on {p.get("machine") or "another computer"}): {status_line(p)}')
        for f in floors_of(p["id"]): print(f'    floor {f["port"]}  {f["name"]:18} lead: {(f.get("lead") or {}).get("name", "?")}')
        mine = p.get("my") or {}
        for port, f in teams().items():
            m = mine.get(port) or {}; print(f'    your floor {port} ({f["name"]}): {"agents can talk" if m.get("on", True) else "agents switched off"}{", requests shared" if m.get("share") else ""}')
elif c in ("request", "accept", "decline", "disconnect", "pause", "resume"):
    with Box() as d:
        p = find(d, pos[0] if pos else sys.exit("which building?")); st = p.get("status", "none"); pid = p["id"]
        if c == "request":
            if st in ("on", "paused"): sys.exit("already connected")
            p["status"] = "on" if st == "in" else "out"   # they had asked too: that is a yes from both
        elif c == "accept":
            if st != "in": sys.exit("they have not asked to connect")
            p["status"] = "on"
        elif c in ("decline", "disconnect"): p["status"] = "none"; p.pop("pausedBy", None); ungrant(p)
        elif c == "pause":
            if st != "on": sys.exit("not connected")
            p["status"], p["pausedBy"] = "paused", "me"
        elif c == "resume":
            if st != "paused" or p.get("pausedBy") != "me": sys.exit("it was not paused from here" if st == "paused" else "not paused")
            p["status"] = "on"; p.pop("pausedBy", None)
        if p["status"] == "on": p["met"] = True   # once connected, its key is kept (forget removes it)
        new = p["status"]; me = d["me"]
    r = call(pid, "/peer/state", {"status": new, "verb": c, "from": me})
    print(f'{p["name"]}: {status_line(p)}' + ("" if r.get("ok") else f' (they could not be told now: {r.get("error", "no answer")})'))
elif c == "floor":
    with Box() as d:
        p = find(d, pos[0]); port = str(pos[1]); m = p.setdefault("my", {}).setdefault(port, {"on": True, "share": False})
        for w in pos[2:]:
            if w in ("on", "off"): m["on"] = w == "on"
            elif w in ("share", "noshare"): m["share"] = w == "share"
        print(json.dumps(m))
elif c in ("ask", "chats"):
    with Box() as d:
        p = find(d, pos[0] if pos else sys.exit("which building?"))
        if len(pos) > 1: p[c] = pos[1] == "on"
        print(f'{p["name"]}: its agents {"can" if p.get("ask") else "cannot"} open requests to the owner here; its owner {"can" if p.get("chats") else "cannot"} read chats here')
elif c == "home":
    with Box() as d:
        if pos: d["home"] = "" if pos[0] == "none" else find(d, pos[0])["id"]
        h = d["peers"].get(d.get("home") or "")
        print(f'requests to the owner also go to {h["name"]} ({status_line(h)})' if h else "requests to the owner stay in this building")
elif c == "forget":
    with Box() as d:
        p = find(d, pos[0] if pos else sys.exit("which building?"))
        if p.get("status", "none") not in ("none", "out"): sys.exit(f'{p["name"]} is {status_line(p)}: disconnect it first')
        d["peers"].pop(p["id"]); d["sent"] = {k: v for k, v in (d.get("sent") or {}).items() if v != p["id"]}
        if d.get("home") == p["id"]: d["home"] = ""
    print(f'{p["name"]} forgotten: it can introduce itself again')
elif c == "forward":   # called by team-ask for a request or note to the owner; the item as JSON on stdin
    x = json.load(sys.stdin)
    with Box() as d: p = d["peers"].get(d.get("home") or ""); me = d["me"]
    if not p: sys.exit(0)
    if p.get("status") != "on": sys.exit(f'not sent to {p["name"]} ({status_line(p)}): it waits here until the owner looks in this building')
    port, fl, me_p = person(x["from"])
    with Box() as d:   # what went where, written BEFORE it goes: only that building may answer it (peers.mjs answerFits)
        sent = d.setdefault("sent", {}); sent[str(x["id"])] = p["id"]
        while len(sent) > 500: sent.pop(next(iter(sent)))
    r = call(p["id"], "/peer/message", {"to": "owner", "text": x["title"], "body": x.get("body", ""), "options": x.get("options") or [], "note": x.get("kind") == "note",
                                        "agent": x["from"], "name": str(x.get("name") or x["from"]).split(" ")[0], "building": me["name"], "fromFloor": fl["name"] if fl else "", "fromPort": int(port) if port else 0, "local": x["id"]})
    if not r.get("ok") and not r.get("unreached"):   # refused there: no answer can come from there (unreached: it may have arrived)
        with Box() as d:
            if (d.get("sent") or {}).get(str(x["id"])) == p["id"]: d["sent"].pop(str(x["id"]))
    err = str(r.get("error", "no answer"))
    try: err = json.loads(err).get("error", err)
    except Exception: pass
    print(f'also in the owner\'s box at {p["name"]}; the answer will arrive in your terminal' if r.get("ok") else f'not sent to {p["name"]} ({err}): it waits in this building')
elif c == "send":
    who = o.get("from") or sys.exit("--from <your Herdr name> is required")
    if len(pos) < 3: sys.exit('team-peer send <building> <floor> "text" --from <you>')
    port, fl, me_p = person(who)
    if not me_p: sys.exit(f"{who} is not someone in this building")
    with Box() as d: p = find(d, pos[0]); me = d["me"]
    if p.get("status") != "on": sys.exit(f'{p["name"]} is {status_line(p)}: agents cannot talk with it now. Only your owner can connect buildings.')
    if not ((p.get("my") or {}).get(port) or {}).get("on", True): sys.exit("your floor is switched off for that building")
    q = pos[1].lower(); tf = [f for f in floors_of(p["id"]) if str(f["port"]) == q or f["name"].lower().startswith(q)]
    if len(tf) != 1: sys.exit("which floor? " + ", ".join(f'{f["port"]} {f["name"]}' for f in floors_of(p["id"])))
    tf = tf[0]; text = pos[2].strip()
    with Box() as d: asked_add(d, p["id"], who)   # its answer is taken only against this: written before it goes
    r = call(p["id"], "/peer/message", {"floor": tf["port"], "text": text, "agent": who, "name": me_p["name"].split(" ")[0], "color": me_p.get("color", "#888"),
                                        "fromFloor": fl["name"], "fromPort": int(port), "building": me["name"]}, floor=tf["port"])
    if not r.get("ok"):
        if not r.get("unreached"):   # refused there; when the link failed it may still have arrived, so its answer stays welcome
            with Box() as d: asked_take(d, p["id"], who)
        sys.exit("not delivered: " + str(r.get("error", "no answer")))
    lead = (tf.get("lead") or {}).get("name", "the lead").split(" ")[0]
    visit({"kind": "out", "floor": int(port), "who": who, "label": f'At {p["name"]} · with {lead}', "text": text[:160], "until": int(time.time() * 1000) + 14000})
    print(f'left with {lead} ({p["name"]}, {tf["name"]}) as request #{r.get("id")}. Their answer will arrive in your terminal.')
elif c == "incoming":   # called by the office server for what arrives from another building; JSON on stdin
    kind = pos[0]; b = json.load(sys.stdin); pid = b.get("peer") or ""
    if kind == "hello":   # first contact through a new tunnel: remember who they are and how to reach their floors
        with Box() as d:
            fr = b["from"]; p = d["peers"].setdefault(fr["id"], {"id": fr["id"], "status": "none", "my": {}})
            if p.get("key") and p["key"] != b.get("key") and (p.get("status") in ("on", "paused", "in") or p.get("met")):
                sys.exit(json.dumps({"error": "this building is already known with another key (its owner here can remove it: team-peer forget)"}))
            p.update({"name": fr.get("name") or fr["id"], "owner": fr.get("owner", ""), "machine": b.get("machine", ""), "key": b.get("key", "")})
            s = seen(); s[fr["id"]] = {"floors": b.get("floors") or [], "at": int(time.time())}; save(SEEN, s)
            print(json.dumps({"ok": True, "me": d["me"], "status": p["status"]}))
    elif kind == "state":
        with Box() as d:
            p = d["peers"].get(pid) or sys.exit(json.dumps({"error": "unknown building"})); verb = b.get("verb"); st = p.get("status", "none"); note = ""
            if verb == "request":
                if st == "out": p["status"] = "on"; note = f'{p["name"]} accepted: your agents can now talk with it.'
                elif st == "none": p["status"] = "in"; note = "ASK"
            elif verb == "accept" and st == "out": p["status"] = "on"; note = f'{p["name"]} accepted: your agents can now talk with it.'
            elif verb in ("decline", "disconnect"):
                if st != "none": note = f'{p["name"]} {"declined the connection" if verb == "decline" else "disconnected"}.'
                p["status"] = "none"; p.pop("pausedBy", None); ungrant(p)
            elif verb == "pause" and st == "on": p["status"], p["pausedBy"] = "paused", "them"; note = f'{p["name"]} paused the connection.'
            elif verb == "resume" and st == "paused" and p.get("pausedBy") == "them": p["status"] = "on"; p.pop("pausedBy", None); note = f'{p["name"]} resumed the connection.'
            if p["status"] == "on": p["met"] = True
            name, owner = p["name"], p.get("owner") or "Someone"
        if note == "ASK": ask("external", "--to", "owner", "--name", f"{owner} · {name}", "--peer", pid, "--connect", "--options", "Accept|Decline", f"{name} wants to connect its agents with yours. Accept?")
        elif note: ask("external", "--to", "owner", "--note", "--name", name, "--peer", pid, note)
        print(json.dumps({"ok": True}))
    elif kind == "message":   # a person or an agent of another building writes to the lead of one of our floors
        d = load(F, {}); p = d.get("peers", {}).get(pid)
        if b.get("to") == "owner":   # an agent of a connected building asks our owner directly (their building's `team-peer home` points here)
            if not p or p.get("status") != "on": sys.exit(json.dumps({"error": "the buildings are not connected"}))
            if not p.get("ask"): sys.exit(json.dumps({"error": "that building does not take requests for its owner from yours"}))
            who = f'{b.get("name") or "Someone"} · {b.get("building") or p.get("name") or "another building"}'
            text = " ".join(str(b.get("text") or "").split()); body = str(b.get("body") or "")[:8000]
            if not text: sys.exit(json.dumps({"error": "empty message"}))
            if len(text) > 140: body = (text + "\n\n" + body).strip()
            op = "|".join(str(o).replace("|", "/") for o in (b.get("options") or [])[:6])
            r = ask("external", "--to", "owner", "--name", who, "--peer", pid, "--ref", json.dumps({"agent": b.get("agent") or "", "fromPort": b.get("fromPort"), "local": b.get("local")}),
                    *(["--note"] if b.get("note") else []), *(["--options", op] if op else []), *(["--body", body] if body else []), text[:140])
            if r.returncode: sys.exit(json.dumps({"error": (r.stderr or r.stdout).strip()[:200]}))
            print(json.dumps({"ok": True, "id": r.stdout.strip().split("\n")[-1]})); sys.exit()
        fl = teams().get(str(b.get("floor"))) or sys.exit(json.dumps({"error": "no such floor"}))
        lead = fl["team"].get("lead"); agent = b.get("agent")
        if agent:   # agents only talk when both owners agreed and neither floor is switched off
            if not p or p.get("status") != "on": sys.exit(json.dumps({"error": "the buildings are not connected"}))
            if not ((p.get("my") or {}).get(str(fl["port"])) or {}).get("on", True): sys.exit(json.dumps({"error": "that floor is not taking messages from your building"}))
        who = f'{b.get("name") or "Someone"} · {b.get("building") or (p or {}).get("name") or "another building"}'
        text = " ".join(str(b.get("text") or "").split())
        if not text: sys.exit(json.dumps({"error": "empty message"}))
        r = ask("external", "--to", lead, "--name", who, "--peer", pid, "--ref", json.dumps({"agent": agent or "", "fromPort": b.get("fromPort")}), *(["--body", text] if len(text) > 140 else []), text[:140])
        if r.returncode: sys.exit(json.dumps({"error": (r.stderr or r.stdout).strip()[:200]}))
        visit({"kind": "in", "floor": int(fl["port"]), "name": b.get("name") or "Visitor", "color": b.get("color") or "#94a3b8", "from": " · ".join(x for x in [b.get("building"), b.get("fromFloor")] if x),
               "to": lead, "text": text[:160], "until": int(time.time() * 1000) + 12000})
        print(json.dumps({"ok": True, "id": r.stdout.strip().split("\n")[-1], "lead": lead}))
    elif kind == "answer":   # the lead over there answered something that left from here
        ref = b.get("ref") or {}; who = b.get("lead") or "The lead"; nm = (load(F, {}).get("peers", {}).get(pid) or {}).get("name", "the other building")
        if ref.get("local"):   # it was a request to the owner opened here: closing it tells the agent and frees their card
            r = ask("answer", str(int(ref["local"])), str(b.get("text", "")), "--as", "__OWNER_ID__")
            if r.returncode:   # not saved here: plain text, so the other building keeps the answer and tries again (503)
                sys.exit("could not save the answer now: " + ((r.stderr or r.stdout).strip()[:200] or f"team-ask exit {r.returncode}"))
            with Box() as d: (d.get("sent") or {}).pop(str(int(ref["local"])), None)
            print(json.dumps({"ok": True})); sys.exit()
        ag = str(ref.get("agent") or ""); msg = f'{who} ({nm}) answered "{str(b.get("title", ""))[:80]}": {b.get("text", "")}'
        to_agent = bool(ag and ag in L.people(admin=True)); queued = None
        try:
            with Box() as d:   # one at a time: is something from here waiting for this answer? keep the answer safe, then use the record up
                cut = time.time() - ASKED_DAYS * 86400
                if not any(x.get("peer") == pid and x.get("agent", "") == ag and x.get("ts", 0) > cut for x in (d.get("asked") or [])):
                    sys.exit(json.dumps({"error": "nothing from here is waiting for an answer from your building"}))
                if to_agent: queued = L.enqueue(ag, msg, "team-peer")   # on disk in their outbox (typed in just below)
                else:
                    r = ask("external", "--to", "owner", "--note", "--name", f"{who} · {nm}", "--peer", pid, *(["--body", b.get("text", "")] if len(msg) > 140 else []), msg[:140])
                    if r.returncode: raise RuntimeError((r.stderr or r.stdout).strip()[:200] or f"team-ask exit {r.returncode}")
                asked_take(d, pid, ag)   # saved with the store; if that save fails the answer is still kept: none is lost
        except SystemExit: raise
        except BaseException as e:
            if queued is None: sys.exit(f"could not take the answer now ({type(e).__name__}: {str(e)[:160]}); try again later")   # plain text: a 503, retried
        if queued is not None:
            try: L.send_queued(ag, queued)
            except Exception: pass   # it waits in the outbox; the watchdog types it in
        print(json.dumps({"ok": True}))
    else: sys.exit(json.dumps({"error": "unknown"}))
elif c == "asked":   # called by peer-link before the owner's message to a visited building goes out (--undo: it did not)
    with Box() as d:
        if not pos or pos[0] not in d["peers"]: sys.exit("unknown building")
        if o.get("undo"): asked_take(d, pos[0], "")
        else: asked_add(d, pos[0], "")
elif c == "answered":   # called by team-ask when one of ours answers an external request; JSON of the item on stdin
    x = json.load(sys.stdin); e = x.get("ext") or {}
    if e.get("connect"):
        v = "accept" if str(x.get("answer", "")).strip().lower().startswith("acc") else "decline"
        print(subprocess.run([sys.argv[0], v, e["peer"]], capture_output=True, text=True).stdout.strip()); sys.exit()
    body = {"ref": e.get("ref") or {}, "text": x.get("answer", ""), "title": x.get("title", ""), "lead": x.get("answeredBy", "")}
    with Pout() as q:   # on disk before the call: a crash or a dead link leaves it queued, never lost
        item = {"peer": e.get("peer"), "path": "/peer/answer", "body": body, "at": time.strftime("%Y-%m-%dT%H:%M:%S"), "req": x.get("id")}
        q.append(item)
    if o.get("queue"): print("kept"); sys.exit()   # --queue (team-ask): only kept; `team-peer flush` sends it
    r = call(e.get("peer"), "/peer/answer", body)
    if not r.get("unreached"):
        with Pout() as q: q[:] = [i for i in q if i != item]
    if r.get("ok"): print("sent back")
    elif r.get("unreached"): print("could not be sent back now (" + str(r.get("error")) + "): it is kept and sent again when the link is back (team-peer flush)")
    else: print("the other building refused it: " + str(r.get("error")))
elif c == "flush":   # try again the answers that could not travel (the watchdog runs this)
    if not os.path.exists(POUT): sys.exit()
    with Pout() as q: todo = list(q)
    for item in todo:
        r = call(item.get("peer"), item.get("path", "/peer/answer"), item.get("body") or {})
        if r.get("unreached"): print(f'#{item.get("req")} to {item.get("peer")}: still waiting ({r.get("error")})'); continue
        with Pout() as q: q[:] = [i for i in q if i != item]
        print(f'#{item.get("req")} to {item.get("peer")}: ' + ("sent back" if r.get("ok") else "refused by the other building: " + str(r.get("error"))))
else: print(__doc__)
