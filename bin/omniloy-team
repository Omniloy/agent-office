#!/usr/bin/env python3
"""omniloy-team start [herdrName...]   start team agents (each on its runtime from team.json) in a Herdr "Team" space
omniloy-team stop [herdrName...]      end them
omniloy-team ls                       who's running, where
omniloy-team runtime <name> <claude|codex>   switch a persona's runtime"""
import json, os, sys, subprocess, re
TEAM = os.path.expanduser(os.environ.get("OMNILOY_TEAM_DIR", "~/.omniloy-team")); CFG = f"{TEAM}/team.json"
t = json.load(open(CFG)); P = {p["herdrName"]: p for p in t["personas"]}
PREFIX = t.get("tabPrefix", "team-"); SPACE = t.get("space", "Team")
KICKOFF = (f"Start your shift: read {TEAM.replace(os.path.expanduser('~'), '~')}/PROTOCOL.md, team.json and your memory file, run your Jira sweep, "
           "and give __OWNER__ a short status (what's on your plate, what you're waiting on). Don't create or change any "
           "Jira tickets or code until __OWNER__ gives you a task.")
def sh(*a): return subprocess.run(a, capture_output=True, text=True)
def running():
    try: return {x.get("name"): x for x in json.loads(sh("hc","ls","--json").stdout)["terminals"]}
    except Exception: return {}
a = sys.argv[1:] or ["start"]; cmd, names = a[0], a[1:] or list(P)
if cmd == "ls":
    r = running()
    for n, p in P.items(): print(f'{n:7} {p["name"]:16} {p["role"]:15} {p["runtime"]:16} {(r[n].get("status") or r[n].get("state") or "running") if n in r else "-"}')
elif cmd == "stop":
    for n in names: print(n, "stopped" if sh("hc","kill",n).returncode == 0 else "not running")
elif cmd == "runtime":
    n, rt = a[1], a[2]; assert rt in t["runtimes"], f"runtime must be one of {list(t['runtimes'])}"
    P[n]["runtime"] = rt; json.dump(t, open(CFG,"w"), indent=2, ensure_ascii=False); print(f"{n} -> {rt} (restart it to apply)")
elif cmd == "start":
    ls = json.loads(sh("herdr-app","ls").stdout or "{}")
    # the team's space: the one that already holds this team's tabs (it may have been renamed), else by name
    sp = [x for x in ls.get("spaces",[]) if any(tb["id"].startswith(PREFIX) for tb in x.get("tabs",[]))] or [x for x in ls.get("spaces",[]) if x.get("name") == SPACE]
    space = sp[0]["id"] if sp else json.loads(sh("herdr-app","do","space.new","--name",SPACE,"--folder",TEAM).stdout)["space"]
    r = running()
    for n in names:
        p = P[n]
        if n in r and r[n].get("state") == "live": print(f"{n} already running"); continue
        rt = t["runtimes"][p["runtime"]]
        argv = [x.replace("{slug}", p["slug"]).replace("{teamDir}", TEAM) for x in rt["argv"]]
        if rt.get("promptFromFile"):
            body = open(os.path.expanduser(f'~/.claude/agents/{p["slug"]}.md')).read().split("---", 2)[2]
            argv.append(body.strip() + "\n\n" + p.get("kickoff", KICKOFF))
        else:
            argv.append(p.get("kickoff", KICKOFF))
        res = sh("hc","run","--bg","--keep","--no-parent","--name",n,"--cwd",TEAM,
                 "--label",f"herdr.space={space}","--label",f"herdr.tab={PREFIX}{n}",
                 "--label",f'team.persona={p["slug"]}',"--label",f'team.runtime={p["runtime"]}',"--",*argv)
        print(f'{n} ({p["name"]}, {p["runtime"]}):', "started" if res.returncode == 0 else "FAILED " + res.stderr.strip()[:200])
        if res.returncode == 0 and p.get("tabName"):
            import time; time.sleep(2); sh("herdr-app","do","tab.rename",json.dumps({"id": f"{PREFIX}{n}", "name": p["tabName"]}))
else: print(__doc__)
