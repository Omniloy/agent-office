#!/usr/bin/env python3
"""team-jira: tiny Jira CLI for the agent team (works from any runtime).
  team-jira search '<JQL>' [max]        team-jira get KEY
  team-jira comment KEY 'markdown-ish text'   team-jira create PROJECT Type 'Summary' 'Description' [label,label] [parentKey]
  team-jira label KEY +backend -frontend   team-jira transitions KEY   team-jira move KEY 'Status name'
  team-jira link KEY OTHERKEY [Relates]  team-jira attach KEY file...
Auth: email in ~/.omniloy-team/team.json, token from keychain service herdr-jira."""
import sys, json, base64, subprocess, urllib.request, urllib.parse, os, uuid, mimetypes
cfg = json.load(open(os.path.expanduser("~/.omniloy-team/team.json"))).get("jira") or {}
if not cfg.get("site") or not cfg.get("email"):
    sys.exit("Jira is not set up on this Mac (no jira.site and jira.email in ~/.omniloy-team/team.json). Cards live in team-card only.")
cfg.setdefault("keychainService", "herdr-jira")
SITE, EMAIL = cfg["site"], cfg["email"]
TOK = subprocess.run(["security","find-generic-password","-s",cfg["keychainService"],"-a",EMAIL,"-w"],capture_output=True,text=True).stdout.strip()
AUTH = "Basic " + base64.b64encode(f"{EMAIL}:{TOK}".encode()).decode()
def req(method, path, body=None, headers=None, raw=None):
    h = {"Authorization": AUTH, "Accept": "application/json"}
    data = raw
    if body is not None: data = json.dumps(body).encode(); h["Content-Type"] = "application/json"
    h.update(headers or {})
    r = urllib.request.Request(SITE + path, data=data, method=method, headers=h)
    try:
        with urllib.request.urlopen(r) as resp:
            t = resp.read(); return json.loads(t) if t else {}
    except urllib.error.HTTPError as e:
        sys.exit(f"HTTP {e.code}: {e.read().decode()[:800]}")
def adf(text):
    return {"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":line}] if line else []} for line in text.split("\n")]}
def plain(node):
    if isinstance(node, dict):
        s = node.get("text","") + "".join(plain(c) for c in node.get("content",[]))
        return s + ("\n" if node.get("type") in ("paragraph","heading","listItem") else "")
    return ""
a = sys.argv[1:]
if not a or a[0] in ("-h","--help"): print(__doc__); sys.exit()
c = a[0]
# In Jira everything reads as __OWNER__: no signatures, no labels that point at a teammate or an agent.
import re as _re
def _clean(text):
    if _re.match(r"\s*\*\*\[[^\]]*\]\*\*", text): sys.exit("refused: no signatures in Jira. Write the comment as __OWNER__, first person, without names (see PROTOCOL.md).")
    return text
def _labels(ls):
    bad = [l for l in ls if _re.match(r"[+-]?(agent-|temp$)", l) and not l.startswith("-")]
    if bad: sys.exit(f"refused: {bad} would show an agent on the card. Who holds a card is kept in team-card, not in Jira labels.")
    return ls
if c == "comment" and len(a) > 2: _clean(a[2])
if c == "create" and len(a) > 5: _labels(a[5].split(","))
if c == "label": _labels(a[2:])
# Nothing in Jira names the team (team-names keeps the list of names).
def _names(*texts):
    try: r = subprocess.run([os.path.expanduser("~/.local/bin/team-names"), "check", "--text", "\n".join(t for t in texts if t)], capture_output=True, text=True)
    except Exception: return
    if r.returncode == 1: sys.exit("refused: " + r.stderr.strip())
if c == "comment" and len(a) > 2: _names(a[2])
if c == "create" and len(a) > 3: _names(*a[3:5])
if c == "search":
    want = int(a[2]) if len(a)>2 else 50; got = 0; tok = None   # Jira gives at most 100 per page: ask for the next ones
    while got < want:
        body = {"jql":a[1],"maxResults":min(100, want-got),"fields":["summary","status","labels","issuetype","assignee","updated"]}
        if tok: body["nextPageToken"] = tok
        r = req("POST","/rest/api/3/search/jql",body); page = r.get("issues",[])
        for i in page:
            f=i["fields"]; print(f'{i["key"]}\t{f["status"]["name"]}\t{f["issuetype"]["name"]}\t{",".join(f["labels"])}\t{f["summary"]}')
        got += len(page); tok = r.get("nextPageToken")
        if not tok or not page: break
elif c == "get":
    i = req("GET",f"/rest/api/3/issue/{a[1]}?fields=summary,status,labels,issuetype,description,comment,issuelinks,parent,attachment")
    f=i["fields"]; print(f'{i["key"]} [{f["issuetype"]["name"]}] {f["summary"]}\nStatus: {f["status"]["name"]}  Labels: {", ".join(f["labels"])}')
    if f.get("parent"): print("Parent:", f["parent"]["key"])
    for l in f.get("issuelinks",[]):
        o=l.get("outwardIssue") or l.get("inwardIssue"); print("Link:", l["type"]["name"], o["key"], o["fields"]["summary"])
    for at in f.get("attachment",[]): print("Attachment:", at["filename"])
    print("\n--- Description ---\n" + plain(f.get("description") or {}))
    for cm in f["comment"]["comments"]: print(f'--- {cm["created"][:16]} ---\n{plain(cm["body"])}')
elif c == "comment":
    r = req("POST",f"/rest/api/3/issue/{a[1]}/comment",{"body":adf(a[2])}); print("commented", r.get("id"))
elif c == "create":
    proj, typ, summ, desc = a[1:5]; labels = a[5].split(",") if len(a)>5 and a[5] else []
    fields={"project":{"key":proj},"issuetype":{"name":typ},"summary":summ,"description":adf(desc),"labels":labels}
    if len(a)>6: fields["parent"]={"key":a[6]}
    print(req("POST","/rest/api/3/issue",{"fields":fields})["key"])
elif c == "label":
    ops=[{"add":x[1:]} if x[0]=="+" else {"remove":x[1:]} for x in a[2:]]
    req("PUT",f"/rest/api/3/issue/{a[1]}",{"update":{"labels":ops}}); print("ok")
elif c == "transitions":
    for t in req("GET",f"/rest/api/3/issue/{a[1]}/transitions")["transitions"]: print(t["id"], t["name"], "->", t["to"]["name"])
elif c == "move":
    ts=req("GET",f"/rest/api/3/issue/{a[1]}/transitions")["transitions"]
    t=[t for t in ts if a[2].lower() in (t["name"].lower(), t["to"]["name"].lower())]
    if not t: sys.exit("no transition to "+a[2]+"; options: "+", ".join(x["to"]["name"] for x in ts))
    req("POST",f"/rest/api/3/issue/{a[1]}/transitions",{"transition":{"id":t[0]["id"]}}); print("moved to", t[0]["to"]["name"])
elif c == "link":
    req("POST","/rest/api/3/issueLink",{"type":{"name":a[3] if len(a)>3 else "Relates"},"inwardIssue":{"key":a[1]},"outwardIssue":{"key":a[2]}}); print("linked")
elif c == "attach":
    for p in a[2:]:
        b=uuid.uuid4().hex; ct=mimetypes.guess_type(p)[0] or "application/octet-stream"
        body=(f'--{b}\r\nContent-Disposition: form-data; name="file"; filename="{os.path.basename(p)}"\r\nContent-Type: {ct}\r\n\r\n').encode()+open(p,"rb").read()+f"\r\n--{b}--\r\n".encode()
        req("POST",f"/rest/api/3/issue/{a[1]}/attachments",headers={"X-Atlassian-Token":"no-check","Content-Type":f"multipart/form-data; boundary={b}"},raw=body); print("attached", p)
else: print(__doc__); sys.exit(1)
