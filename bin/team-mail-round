#!/usr/bin/env python3
"""team-mail-round: tell the Business lead that an email round is due. Run by launchd (com.omniloy.mail-round)
every few minutes; it only speaks when a round is due, inside working hours, and the lead is running.

  team-mail-round           send the nudge if one is due
  team-mail-round --now     send it now (still only if the lead is running)
  team-mail-round --status  say when the next one is due

Settings: "mailRound" in ~/.omniloy-biz/team.json, e.g. {"everyHours": 2, "from": "08:00", "to": "20:00", "days": [1,2,3,4,5]}
(days: 1 Monday ... 7 Sunday). Remove "mailRound" to switch the rounds off. Works the same for Claude Code and Codex."""
import sys, os, json, subprocess, datetime
BIZ = os.path.expanduser("~/.omniloy-biz"); STATE = BIZ + "/mail-round.json"
t = json.load(open(BIZ + "/team.json")); r = t.get("mailRound")
if not r: sys.exit(0 if len(sys.argv) < 2 else "Email rounds are off (no mailRound in ~/.omniloy-biz/team.json).")
lead = t.get("lead") or "irene"; every = float(r.get("everyHours") or 2)
now = datetime.datetime.now(); hm = now.strftime("%H:%M")
try: last = datetime.datetime.fromisoformat(json.load(open(STATE))["last"])
except Exception: last = None
due = last is None or (now - last).total_seconds() >= every * 3600 - 60
inside = r.get("from", "08:00") <= hm < r.get("to", "20:00") and now.isoweekday() in (r.get("days") or [1, 2, 3, 4, 5])
a = sys.argv[1] if len(sys.argv) > 1 else ""
if a == "--status":
    nxt = "now" if due else (last + datetime.timedelta(hours=every)).strftime("%H:%M")
    print(f"every {every:g} h, {r.get('from', '08:00')} to {r.get('to', '20:00')}; last {last.strftime('%Y-%m-%d %H:%M') if last else 'never'}; next {nxt}{'' if inside else ' (outside working hours now)'}"); sys.exit(0)
if a != "--now" and not (due and inside): sys.exit(0)
text = ("Email round: run the email-triaje skill on __OWNER__'s inbox following your role file, then check "
        f"`team-ask ls --to {lead}`. Drafts only: never send. If Gmail is not connected, tell __OWNER__ with team-ask instead.")
# only when the lead is waiting for work: a round never interrupts something in progress (it is tried again in a few minutes)
import shutil
hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
if not os.path.exists(hc): print("not sent (Herdr's hc command was not found)"); sys.exit(1 if a == "--now" else 0)
res = subprocess.run([hc, "send", "--if", "idle", lead, text], capture_output=True, text=True)
if res.returncode == 0:
    json.dump({"last": now.isoformat(timespec="seconds")}, open(STATE, "w")); print(f"round sent to {lead}")
else: print(f"not sent ({(res.stderr or res.stdout).strip()[:160] or 'the lead is busy or not running'})"); sys.exit(1 if a == "--now" else 0)
