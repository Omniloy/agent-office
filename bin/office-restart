#!/usr/bin/env python3
"""office-restart status | all | <port> [--new-token]   restart office servers one at a time, keeping each page token so open
phones keep working. A floor that is not running is started. Tokens stay in memory and are never printed.
Only the office's own listener on 127.0.0.1 is touched: Tailscale listens on the same ports and must not be killed."""
import sys, os, re, subprocess, time, urllib.request, signal
H = os.path.expanduser
FLOORS = {'4317': ('Dev', H('~/.omniloy-office/team-office'), ''), '4318': ('Business', H('~/.omniloy-office/biz-office'), H('~/.omniloy-biz')),
          '4322': ('Miscelaneous', H('~/.omniloy-office/team-office'), H('~/.omniloy-misc'))}
# an optional floor counts only where its team folder exists (Miscelaneous is `floors: []` by default)
FLOORS = {p: v for p, v in FLOORS.items() if not v[2] or os.path.exists(os.path.join(v[2], 'team.json'))}
def get(port, path): return urllib.request.urlopen(f'http://127.0.0.1:{port}{path}', timeout=5).read().decode()
def up(port):
    try: return '"ok":true' in get(port, '/health')
    except Exception: return False
def listener(port): return subprocess.run(['lsof', '-nP', f'-iTCP@127.0.0.1:{port}', '-sTCP:LISTEN', '-Fp'], capture_output=True, text=True).stdout.split('\n')[0].lstrip('p')
def node():
    import glob, shutil
    for c in [shutil.which('node') or '', '/opt/homebrew/bin/node', '/usr/local/bin/node', *sorted(glob.glob(H('~/.nvm/versions/node/*/bin/node')), reverse=True)]:
        if c and os.path.exists(c): return c
    return 'node'
NEW = '--new-token' in sys.argv  # give the floor a fresh page token (open pages need one reload)
def restart(port):
    name, cwd, team = FLOORS[port]; tok = ''
    if up(port):
        m = re.search(r"__TOKEN__ = '([0-9a-f]+)'", get(port, '/')); tok = m.group(1) if m else ''
        pid = listener(port)
        if pid: os.kill(int(pid), signal.SIGTERM)
        for _ in range(40):
            time.sleep(0.25)
            if not listener(port): break
    env = {**os.environ, 'PORT': port}
    if tok and not NEW: env['OFFICE_TOKEN'] = tok
    if team: env['TEAM_DIR'] = team
    logdir = H('~/.omniloy-team/logs'); os.makedirs(logdir, exist_ok=True)
    log = open(os.path.join(logdir, f'office-{port}.log'), 'ab')  # why a floor died: its last errors are here
    log.write(f'\n--- started {time.strftime("%Y-%m-%d %H:%M:%S")}\n'.encode()); log.flush()
    subprocess.Popen([node(), os.path.join(cwd, 'server.mjs')], cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log, start_new_session=True)
    for i in range(60):
        time.sleep(0.5)
        if up(port): print(f'{name} ({port}): back after {(i + 1) / 2:.1f}s'); return True
    print(f'{name} ({port}): DID NOT COME BACK'); return False
a = sys.argv[1] if len(sys.argv) > 1 else ''
if a == 'status':
    for p, (n, _, _) in FLOORS.items(): print(f'{n} ({p}): {"up" if up(p) else "DOWN"}')
elif a == 'all': sys.exit(0 if all([restart(p) for p in FLOORS]) else 1)
elif a in FLOORS: sys.exit(0 if restart(a) else 1)
else: print(__doc__); sys.exit(2)
